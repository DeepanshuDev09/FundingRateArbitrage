DASHBOARD_PASSWORD=change-me     # password to open the site (browser asks once, username can be anything)

# Unit/interval ASSUMPTIONS: compare BTC with each exchange app, then fix these if numbers look 100x off.
DELTA_RATE_IN_PERCENT=true       # Delta funding_rate: true = percent (0.01 = 0.01%)
DELTA_INTERVAL_HOURS=8
CS_RATE_IN_PERCENT=false         # CoinSwitch "r": false = fraction (0.0001 = 0.01%)
CS_INTERVAL_HOURS=8
MIN_VOLUME_USDT=100000           # hide coins whose known 24h volume is below this on either exchange
