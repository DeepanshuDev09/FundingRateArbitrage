# Funding units/intervals are ASSUMPTIONS - verify against each exchange app before trusting spreads.
DELTA_RATE_IN_PERCENT=true      # Delta ticker funding_rate: true = value is a percent (0.01 = 0.01%)
DELTA_INTERVAL_HOURS=8
CS_RATE_IN_PERCENT=false        # CoinSwitch "r": false = fraction (0.0001 = 0.01%)
CS_INTERVAL_HOURS=8
CS_SNAPSHOT_MS=3500             # how long to listen on the NATS stream

# --- Milestone 2 ---
DASHBOARD_PASSWORD=change-me          # password to open the site (browser asks once; username can be anything)

DATABASE_URL=postgres://...           # Neon connection string (tables are created automatically)
CRON_SECRET=another-long-random-string
# Alert rules. FEE_ROUND_TRIP_PCT is a PLACEHOLDER: set it from both exchanges' real taker fees (4 fills: open+close on 2 legs).
ALERT_MIN_NET_APR_PCT=30
FEE_ROUND_TRIP_PCT=0.2
ASSUMED_HOLD_HOURS=24
ALERT_MIN_VOLUME_USDT=100000
ALERT_COOLDOWN_MINUTES=60
ALERT_REALERT_GROWTH_PCT=50
OUTAGE_AFTER_FAILURES=3
RETENTION_DAYS=30
